# Obligatoire : secret pour les tokens JWT (generer avec: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=

# Obligatoire : secret pour le chiffrement des API keys (peut etre identique a JWT_SECRET)
API_KEYS_SECRET=

# Optionnel : cles API des providers (surchargent les cles stockees en base)
URLSCAN_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
VT_API_KEY=
ABUSEIPDB_API_KEY=

# Optionnel : force le flag Secure sur les cookies (recommande en HTTPS / production)
# COOKIE_SECURE=true

# Optionnel : chemin de la base SQLite
# URL_TRUST_ANALYZER_DB=

# Optionnel : timeout par provider en secondes (defaut : 30)
# PROVIDER_TIMEOUT_SECONDS=30

# Optionnel : cache des resultats d analyse (sans cle API utilisateur)
# ANALYSIS_CACHE_TTL_SECONDS=300
# ANALYSIS_CACHE_MAX_SIZE=200

# Admin : credentials pour le panneau de configuration du scoring
# Si absent, l acces admin est desactive
# ADMIN_USERNAME=
# ADMIN_PASSWORD=